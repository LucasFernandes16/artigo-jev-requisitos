# ============================================================================
# Chaves de API para execução dos experimentos (copie para .env)
# ============================================================================

# 1. TypeSafe AI (JEV System One API Oficial)
TYPESAFE_API_KEY="sua-chave-typesafe-aqui"
TYPESAFE_DEFAULT_MODEL="jev-latest"

# 2. Google Gemini API (Google AI Studio)
GEMINI_API_KEY="sua-chave-gemini-aqui"
GEMINI_GENERATOR_MODEL="gemini-2.5-flash"
GEMINI_JUDGE_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# 3. OpenRouter / OpenAI-compatible (Comparação 1:1 com Qwen3-235B do artigo)
OPENROUTER_API_KEY="sua-chave-openrouter-aqui"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_GENERATOR_MODEL="qwen/qwen3-235b-a22b-2507"
OPENROUTER_JUDGE_MODEL="openai/gpt-oss-120b"
OPENROUTER_EMBEDDING_MODEL="qwen/qwen3-embedding-8b"
