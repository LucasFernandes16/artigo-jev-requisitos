            <row>
                <id><![CDATA[18548]]></id>
                <qid><![CDATA[17379]]></qid>
                <question><![CDATA[<p>The decision made to detail or change requirements shall be documented in the project manual.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18549]]></id>
                <qid><![CDATA[17380]]></qid>
                <question><![CDATA[<p>The decision to detail or change requirements shall be documented in the project manual.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18550]]></id>
                <qid><![CDATA[17381]]></qid>
                <question><![CDATA[<p>The project shall document decisions regarding requirement detailing and requirement changes in the project manual.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18551]]></id>
                <qid><![CDATA[17382]]></qid>
                <question><![CDATA[<p>The system shall document decisions regarding the detailing or changing of requirements in the project manual.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18552]]></id>
                <qid><![CDATA[17383]]></qid>
                <question><![CDATA[<p>The project team shall document descriptions of decisions made to detail and/or change requirements in the project manual.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18553]]></id>
                <qid><![CDATA[17384]]></qid>
                <question><![CDATA[<p>The project manual shall contain descriptions of problems that occurred during implementation and their solutions.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
