            <row>
                <id><![CDATA[19058]]></id>
                <qid><![CDATA[17889]]></qid>
                <question><![CDATA[<p>The system shall provide the organizer with the ability to add SINGLE CHOICE questions to a poll.</p><p>The system shall provide the organizer with the ability to add MULTIPLE CHOICE questions to a poll.</p><p>The system shall provide the organizer with the ability to add YES/NO questions to a poll.</p>]]></question>
