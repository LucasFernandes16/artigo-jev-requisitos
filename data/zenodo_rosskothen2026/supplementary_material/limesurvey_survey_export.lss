            <row>
                <id><![CDATA[18803]]></id>
                <qid><![CDATA[17634]]></qid>
                <question><![CDATA[<p>The TSS shall provide assistants and supervisors with the ability to start a contract.</p><p>As soon as a contract is started, it shall change from PREPARED to STARTED status.</p><p>All Timesheets shall be created in IN_PROGRESS status.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
