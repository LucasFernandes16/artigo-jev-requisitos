            <row>
                <id><![CDATA[18804]]></id>
                <qid><![CDATA[17635]]></qid>
                <question><![CDATA[<p>The system TSS shall provide the assistants with the ability to start a contract.</p><p>The system TSS shall provide the supervisors with the ability to start a contract.</p><p>As soon as a contract is started, the system TSS shall change the contract status from PREPARED to STARTED.</p><p>All timesheets shall be created with status IN_PROGRESS.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18805]]></id>
                <qid><![CDATA[17636]]></qid>
                <question><![CDATA[<p>If the system TSS sets the status of the contract to STARTED, the system TSS shall create each Timesheet with the status IN_PROGRESS.</p><p>If the assistant starts a contract or if the supervisor starts a contract and if the contract has the status PREPARED, the system TSS shall set the status of the contract to STARTED.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
            <row>
                <id><![CDATA[18806]]></id>
                <qid><![CDATA[17637]]></qid>
                <question><![CDATA[<p>The TSS shall create all Timesheets with status IN_PROGRESS.</p><p>As soon as assistants and supervisors start a contract, the TSS shall change the contract status from PREPARED to STARTED.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
            </row>
