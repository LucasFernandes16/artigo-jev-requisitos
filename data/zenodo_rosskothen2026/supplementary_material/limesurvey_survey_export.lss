                <id><![CDATA[18808]]></id>
                <qid><![CDATA[17639]]></qid>
                <question><![CDATA[<p>The TSS shall ensure that time sheet entries can only be added when the time sheet is in IN_PROGRESS status and the contract of the time sheet is in STARTED status.</p><p>The TSS shall ensure that time sheet entries can only be changed when the time sheet is in IN_PROGRESS status and the contract of the time sheet is in STARTED status.</p><p>The TSS shall ensure that time sheet entries can only be removed when the time sheet is in IN_PROGRESS status and the contract of the time sheet is in STARTED status.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
