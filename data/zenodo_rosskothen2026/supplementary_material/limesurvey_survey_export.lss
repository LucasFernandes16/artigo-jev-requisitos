            <row>
                <id><![CDATA[19059]]></id>
                <qid><![CDATA[17890]]></qid>
                <question><![CDATA[<p>The system shall provide the organizer with the ability to add a single-choice question to a poll.</p><p>The system shall provide the organizer with the ability to add a multiple-choice question to a poll.</p><p>The system shall provide the organizer with the ability to add a yes/no question to a poll.</p>]]></question>
                <help />
                <script />
                <language><![CDATA[en]]></language>
